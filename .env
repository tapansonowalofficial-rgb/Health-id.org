# ============================================================
# Health-ID Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Anthropic Claude AI ---
# Keep this SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix)
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# --- MSG91 SMS OTP ---
MSG91_API_KEY=YOUR_MSG91_AUTH_KEY
MSG91_TEMPLATE_ID=YOUR_OTP_TEMPLATE_ID
MSG91_SENDER_ID=HLTHID

# --- App Config ---
NEXT_PUBLIC_APP_URL=https://www.health-id.in
NEXT_PUBLIC_APP_NAME=Neural Health ID
JWT_SECRET=generate_a_random_64_char_string_here

# --- UIDAI Aadhaar (Sandbox) ---
# Register at: https://developer.uidai.gov.in
UIDAI_API_KEY=YOUR_UIDAI_SANDBOX_KEY
UIDAI_BASE_URL=https://stage1.uidai.gov.in/uidVerifyService/2.5